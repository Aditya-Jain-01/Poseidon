# Poseidon backend environment
# Copy this file to .env in the repository root and add your credentials.
# The backend reads this file through app.config.Settings; OS environment
# variables can override its values. Restart the backend after changes.

# Primary agent: memory-store/llm_config.json assigns Poseidon the "env" preset.
# These endpoint and model values match the current backend defaults.
# Set NVIDIA_API_KEY to use this hosted model.
POSEIDON_BASE_URL=https://integrate.api.nvidia.com/v1
POSEIDON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=

# Optional credentials. Per-agent provider presets and overrides are stored in
# memory-store/llm_config.json; cloud_free uses NVIDIA_API_KEY and cloud_paid
# uses KRAKEN_API_KEY. POSEIDON_API_KEY is a direct key for the primary agent.
POSEIDON_API_KEY=
KRAKEN_API_KEY=
OPENROUTER_API_KEY=

# For local Ollama instead, set POSEIDON_BASE_URL=http://localhost:11434/v1
# and POSEIDON_MODEL=llama3.2. The local endpoint needs no real API key.

# HTTP server. Non-loopback hosting requires POSEIDON_API_TOKEN and explicit
# CORS origins. Match the host/port used by your server command.
POSEIDON_HOST=127.0.0.1
POSEIDON_PORT=8000
POSEIDON_API_TOKEN=
POSEIDON_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Execution and approval limits.
POSEIDON_MAX_ITERATIONS=5
POSEIDON_MAX_TOOL_CALLS=5
POSEIDON_APPROVAL_TIMEOUT_SECONDS=3600

# Memory defaults. Paths default to locations under the repository's
# memory-store/ directory; uncomment only when using a different location.
POSEIDON_CONSOLIDATION_THRESHOLD=30
POSEIDON_RECENT_TURNS=12
# POSEIDON_DB_PATH=memory-store/state.db
# POSEIDON_CHECKPOINT_DB_PATH=memory-store/checkpoints.db
# AGENTS_DIR=memory-store/agents
# LLM_CONFIG_PATH=memory-store/llm_config.json
# POSEIDON_EMBEDDING_MODEL=all-MiniLM-L6-v2
# POSEIDON_EMBEDDING_DIM=384

# Telegram is disabled until polling is enabled and a bot token is supplied.
# An empty allowlist rejects all Telegram senders. IDs are comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLLING_ENABLED=false
# Set a webhook secret before exposing the optional webhook endpoint.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAX_UPDATE_ATTEMPTS=5
# Optional PIN for Telegram approval verification.
POSEIDON_OPERATOR_PIN=

# The frontend reads VITE_API_URL from frontend/.env or its build environment,
# not from this backend .env. In local development, Vite proxies API requests.
