# Poseidon — Environment Variables
# Copy to .env and fill in your values

# === LLM Provider ===
# OpenRouter API key (required for cloud free models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional OpenAI subscription key for Kraken / custom paid tier
KRAKEN_API_KEY=your-openai-api-key-here

# Model identifier (any OpenRouter-supported model)
POSEIDON_MODEL=google/gemma-4-31b-it:free

# Base URL for the OpenAI-compatible API
POSEIDON_BASE_URL=https://openrouter.ai/api/v1

# === Server ===
POSEIDON_HOST=127.0.0.1
POSEIDON_PORT=8000

# === Guardrails ===
POSEIDON_MAX_ITERATIONS=5
POSEIDON_MAX_TOOL_CALLS=5
POSEIDON_MAX_APPROVAL_REQUESTS_PER_HOUR=5
POSEIDON_OUTBOUND_MSG_RATE_LIMIT=20
POSEIDON_CRONJOB_APPROVAL_TIMEOUT_HOURS=12

# === Note Guardrails (guarded_auto tier) ===
# Max characters allowed in a single note or reminder (default: 500)
POSEIDON_NOTE_MAX_LENGTH=500
# Max total notes + reminders that can be stored before rejecting new ones (default: 500)
POSEIDON_NOTE_MAX_TOTAL=500

# === Operator PIN (Step-Up Approval) ===
# Set a short PIN for verifying suspicious note approvals and future Telegram hardening.
# Leave empty to rely on the web UI approval gate only (safe for local-only setups).
POSEIDON_OPERATOR_PIN=

# === Memory ===
POSEIDON_CONSOLIDATION_THRESHOLD=30

# === Telegram Gateway Adapter ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id-here
# TELEGRAM_WEBHOOK_SECRET=optional-webhook-secret
