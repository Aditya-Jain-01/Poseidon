# Poseidon — Environment Variables
# Copy to .env and fill in your values

# === LLM Provider ===
# OpenRouter API key (required for cloud free models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional OpenAI subscription key for Kraken / custom paid tier
KRAKEN_API_KEY=your-openai-api-key-here

# Model identifier (any OpenRouter-supported model)
POSEIDON_MODEL=google/gemma-4-31b-it:free

# Base URL for the OpenAI-compatible API
POSEIDON_BASE_URL=https://openrouter.ai/api/v1

# === Server ===
POSEIDON_HOST=127.0.0.1
POSEIDON_PORT=8000

# === Guardrails (Sprint 3+, configured here for forward-compat) ===
POSEIDON_MAX_ITERATIONS=5
POSEIDON_MAX_TOOL_CALLS=5
POSEIDON_MAX_APPROVAL_REQUESTS_PER_HOUR=5
POSEIDON_OUTBOUND_MSG_RATE_LIMIT=20
POSEIDON_CRONJOB_APPROVAL_TIMEOUT_HOURS=12

# === Memory (Sprint 2+, configured here for forward-compat) ===
POSEIDON_CONSOLIDATION_THRESHOLD=30
